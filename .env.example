# Copy this file to .env and edit values as needed. Never commit .env.
APP_TITLE=Credence Risk

# Paths are relative to the project root unless absolute.
MODELS_DIR=models
REPORTS_DIR=reports

# Illustrative risk-band cut-offs: Low < first <= Moderate < second <= Elevated < third <= High
RISK_BAND_THRESHOLDS=0.10,0.30,0.50

# Upload limits for Batch Scoring
MAX_UPLOAD_MB=20
MAX_UPLOAD_ROWS=50000